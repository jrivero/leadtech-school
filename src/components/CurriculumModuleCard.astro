---
import type { Locale } from '../lib/i18n';

interface LessonItem {
  id: string;
  href: string;
  title: string;
  order: number;
  optional?: boolean;
}

interface ModuleItem {
  id: string;
  order: number;
  title: string;
  description: string;
  phase: number;
  level: string;
  supplement?: boolean;
  lessons: LessonItem[];
}

interface Props {
  module: ModuleItem;
  locale: Locale;
  coreModuleCount: number;
  supplementCount: number;
  supplementIndex?: number;
  initialOpen?: boolean;
}

const {
  module,
  locale,
  coreModuleCount,
  supplementCount,
  supplementIndex = 0,
  initialOpen = false,
} = Astro.props;
const isSupplement = module.supplement === true;
const orderedLessons = module.lessons.slice().sort((a, b) => a.order - b.order);
const copy = locale === 'en'
  ? {
      searchTerms: 'optional extra core module',
      optional: 'Optional',
      optionalExtra: 'Optional extra',
      lesson: 'lesson',
      lessons: 'lessons',
      inModule: 'IN THIS MODULE',
      extra: 'EXTRA',
      module: 'MODULE',
    }
  : {
      searchTerms: 'complemento opcional extra módulo principal',
      optional: 'Opcional',
      optionalExtra: 'Complemento opcional',
      lesson: 'lección',
      lessons: 'lecciones',
      inModule: 'EN ESTE MÓDULO',
      extra: 'EXTRA',
      module: 'MÓDULO',
    };
const searchText = [module.title, module.description, module.level, copy.searchTerms].join(' ');
const pluralizeLessons = (count: number) => `${count} ${count === 1 ? copy.lesson : copy.lessons}`;
---
<details
  id={`module-${module.id}`}
  class:list={['module-card', isSupplement && 'module-card--supplement']}
  data-module-card
  data-phase={module.phase}
  data-supplement={String(isSupplement)}
  data-search={searchText}
  open={initialOpen}
>
  <summary class="module-card__summary">
    <span class="module-card__number" aria-hidden="true">{isSupplement ? `+${String(supplementIndex).padStart(2, '0')}` : String(module.order).padStart(2, '0')}</span>
    <span class="module-card__copy">
      <span class="module-card__eyebrow">
        {isSupplement
          ? <span class="module-card__badge">{copy.optionalExtra}</span>
          : <span>{module.level}</span>}
        <i aria-hidden="true">·</i>
        <span>{pluralizeLessons(module.lessons.length)}</span>
      </span>
      <strong>{module.title}</strong>
      <span class="module-card__description">{module.description}</span>
    </span>
    <span class="module-card__toggle" aria-hidden="true">
      <svg viewBox="0 0 20 20"><path d="M10 4v12M4 10h12" /></svg>
    </span>
  </summary>
  <div class="module-card__content">
    <div class="module-card__content-heading">
      <p>{isSupplement ? copy.optionalExtra.toUpperCase() : copy.inModule}</p>
      <span>
        {isSupplement
          ? `${copy.extra} ${String(supplementIndex).padStart(2, '0')} / ${String(supplementCount).padStart(2, '0')}`
          : `${copy.module} ${String(module.order).padStart(2, '0')} / ${String(coreModuleCount).padStart(2, '0')}`}
      </span>
    </div>
    <ol class="lesson-list">
      {orderedLessons.map((lesson, lessonIndex) => (
        <li class="lesson-list__item" data-lesson-item data-search={lesson.title}>
          <span class="lesson-list__number" aria-hidden="true">{String(lesson.order ?? lessonIndex + 1).padStart(2, '0')}</span>
          <a
            class="lesson-list__link"
            href={lesson.href}
            data-lesson-link
            data-lesson-id={lesson.id}
          >
            <span>{lesson.title}</span>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8 4l4 4-4 4" /></svg>
          </a>
          {lesson.optional && !isSupplement && <span class="lesson-list__optional">{copy.optional}</span>}
        </li>
      ))}
    </ol>
  </div>
</details>
