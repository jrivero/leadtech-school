---
import CurriculumModuleCard from './CurriculumModuleCard.astro';
import type { Locale } from '../lib/i18n';

interface LessonItem {
  id: string;
  href: string;
  title: string;
  order: number;
  optional?: boolean;
}

interface ModuleItem {
  id: string;
  order: number;
  title: string;
  description: string;
  phase: number;
  level: string;
  supplement?: boolean;
  lessons: LessonItem[];
}

interface PhaseItem {
  id: number;
  title: string;
}

interface Props {
  locale: Locale;
  modules: ModuleItem[];
  phases: PhaseItem[];
  totalLessons: number;
}

const { locale, modules, phases, totalLessons } = Astro.props;
const copy = locale === 'en'
  ? {
      index: '01 / THE ROADMAP',
      eyebrow: 'SOFTWARE DEVELOPMENT WITH AI · ONE LEARNING PATH',
      titleFirst: 'Learn the fundamentals.',
      titleSecond: 'Build with purpose.',
      intro: 'A path to building software with AI: start with the fundamentals, then explore tools and learn to review what you build. Optional extras expand this same program.',
      coreModule: 'core module',
      coreModules: 'core modules',
      optionalExtra: 'optional extra',
      optionalExtras: 'optional extras',
      lesson: 'lesson',
      lessons: 'lessons',
      curriculumTotal: (core: number, extra: number, total: number) => `${core} core ${core === 1 ? 'module' : 'modules'} and ${extra} optional ${extra === 1 ? 'extra' : 'extras'}; ${total} ${total === 1 ? 'lesson' : 'lessons'} in total`,
      progressLabel: 'Your learning progress',
      progressEyebrow: 'YOUR LEARNING PATH',
      progressLessonsCompleted: 'lessons completed',
      progressSaved: 'Your progress is saved in this browser.',
      progressMeter: 'Lesson progress',
      progressContinue: 'Continue learning',
      searchLabel: 'Search modules and lessons',
      searchPlaceholder: 'Search for a topic or lesson',
      clearSearch: 'Clear search',
      filterLabel: 'Filter by phase',
      all: 'All',
      showAll: 'Show all',
      phase: 'Phase',
      filterPhase: 'Filter phase',
      resultsHint: 'Open a module to see its lessons',
      noResults: 'No results found',
      noResultsHint: 'Try another search or show all phases again.',
      clearFilters: 'Clear filters',
      phaseLabel: 'PHASE',
      supplementHeading: 'Optional extras',
      deeperHeading: 'For a deeper dive',
      deeperText: 'Extras within the same path. Save them for later or come back when they are useful.',
      extra: 'extra',
      extras: 'extras',
      inModule: 'IN THIS MODULE',
      caveat: 'Self-guided, non-accredited learning: optional extras are part of this same program.',
      progressAria: 'lessons completed',
    }
  : {
      index: '01 / EL RECORRIDO',
      eyebrow: 'DESARROLLO CON IA · UN ÚNICO RECORRIDO',
      titleFirst: 'Aprende la base.',
      titleSecond: 'Construye con intención.',
      intro: 'Un recorrido para desarrollar software con IA: primero las bases, luego las herramientas y el criterio para revisar lo que construyes. Los complementos opcionales amplían este mismo programa.',
      coreModule: 'módulo principal',
      coreModules: 'módulos principales',
      optionalExtra: 'complemento opcional',
      optionalExtras: 'complementos opcionales',
      lesson: 'lección',
      lessons: 'lecciones',
      curriculumTotal: (core: number, extra: number, total: number) => `${core} ${core === 1 ? 'módulo principal' : 'módulos principales'} y ${extra} ${extra === 1 ? 'complemento opcional' : 'complementos opcionales'}; ${total} ${total === 1 ? 'lección' : 'lecciones'} en total`,
      progressLabel: 'Tu progreso de aprendizaje',
      progressEyebrow: 'TU RECORRIDO',
      progressLessonsCompleted: 'lecciones completadas',
      progressSaved: 'Tu avance se guarda en este navegador.',
      progressMeter: 'Progreso de las lecciones',
      progressContinue: 'Continuar el recorrido',
      searchLabel: 'Buscar módulos y lecciones',
      searchPlaceholder: 'Busca un tema o una lección',
      clearSearch: 'Borrar búsqueda',
      filterLabel: 'Filtrar por fase',
      all: 'Todo',
      showAll: 'Mostrar todo',
      phase: 'Fase',
      filterPhase: 'Filtrar fase',
      resultsHint: 'Abre un módulo para ver sus lecciones',
      noResults: 'No encontramos resultados',
      noResultsHint: 'Prueba con otra palabra o vuelve a ver todas las fases.',
      clearFilters: 'Limpiar filtros',
      phaseLabel: 'FASE',
      supplementHeading: 'Complementos opcionales',
      deeperHeading: 'Para seguir profundizando',
      deeperText: 'Extras del mismo recorrido; puedes dejarlos para después o volver a ellos cuando te resulten útiles.',
      extra: 'extra',
      extras: 'extras',
      inModule: 'EN ESTE MÓDULO',
      caveat: 'Ruta autónoma y no acreditada: los complementos son opcionales y pertenecen a este mismo programa.',
      progressAria: 'lecciones completadas',
    };
const orderedModules = [...modules].sort((a, b) => a.order - b.order);
const coreModules = orderedModules.filter((module) => module.supplement !== true);
const supplementModules = orderedModules.filter((module) => module.supplement === true);
const phaseGroups = phases.map((phase) => {
  const phaseModules = orderedModules.filter((module) => module.phase === phase.id);
  const phaseCoreModules = phaseModules.filter((module) => module.supplement !== true);
  const phaseSupplementModules = phaseModules.filter((module) => module.supplement === true);
  return {
    phase,
    coreModules: phaseCoreModules,
    supplementModules: phaseSupplementModules,
    lessonCount: phaseModules.reduce((count, module) => count + module.lessons.length, 0),
  };
});
const firstModule = orderedModules[0];
const firstLesson = firstModule?.lessons.slice().sort((a, b) => a.order - b.order)[0];
const firstLessonHref = firstLesson?.href ?? '#temario';
const pluralize = (count: number, singular: string, plural: string) => `${count} ${count === 1 ? singular : plural}`;
const phaseFilterCount = (phaseId: number) => {
  const group = phaseGroups.find((entry) => entry.phase.id === phaseId);
  if (!group) return '0';
  return group.supplementModules.length > 0
    ? `${group.coreModules.length}+${group.supplementModules.length}`
    : String(group.coreModules.length);
};
const phaseDescription = (phaseId: number) => {
  const group = phaseGroups.find((entry) => entry.phase.id === phaseId);
  if (!group) return `0 ${copy.coreModules}`;
  const coreDescription = pluralize(group.coreModules.length, copy.coreModule, copy.coreModules);
  return group.supplementModules.length > 0
    ? `${coreDescription} + ${pluralize(group.supplementModules.length, copy.optionalExtra, copy.optionalExtras)}`
    : coreDescription;
};
---
<section class="curriculum-section page-width" id="temario" data-curriculum-explorer data-locale={locale} aria-labelledby="curriculum-title">
  <div class="section-intro curriculum-section__intro">
    <div class="section-intro__index">
      <span class="section-index">{copy.index}</span>
      <span class="section-index__line" aria-hidden="true"></span>
    </div>
    <div class="section-intro__body">
      <p class="eyebrow eyebrow--terra">{copy.eyebrow}</p>
      <h2 class="section-title" id="curriculum-title">{copy.titleFirst}<br /><em>{copy.titleSecond}</em></h2>
      <p class="section-intro__description">{copy.intro}</p>
    </div>
    <div
      class="curriculum-total"
      aria-label={copy.curriculumTotal(coreModules.length, supplementModules.length, totalLessons)}
    >
      <strong>{String(coreModules.length).padStart(2, '0')}</strong>
      <span>{copy.coreModules}<br />+ {supplementModules.length} {copy.optionalExtras}</span>
    </div>
  </div>

  <div class="curriculum-progress" data-progress-panel hidden aria-label={copy.progressLabel}>
    <div class="curriculum-progress__copy">
      <span class="eyebrow">{copy.progressEyebrow}</span>
      <p class="curriculum-progress__count"><strong><span data-progress-count>0</span> {locale === 'en' ? 'of' : 'de'} {totalLessons}</strong> {copy.progressLessonsCompleted}</p>
      <p class="curriculum-progress__message" data-progress-message>{copy.progressSaved}</p>
    </div>
    <div
      class="curriculum-progress__meter"
      role="progressbar"
      aria-label={copy.progressMeter}
      aria-valuemin="0"
      aria-valuemax={totalLessons}
      aria-valuenow="0"
      aria-valuetext={`0 ${locale === 'en' ? 'of' : 'de'} ${totalLessons} ${copy.progressAria}`}
      data-progress-meter
    >
      <span data-progress-fill></span>
    </div>
    <a class="curriculum-progress__link" href={firstLessonHref} data-continue-link>
      <span data-progress-link-label>{copy.progressContinue}</span>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8 4l4 4-4 4" /></svg>
    </a>
  </div>

  <div class="curriculum-tools" data-curriculum-controls hidden>
    <div class="curriculum-search">
      <label class="visually-hidden" for="curriculum-search">{copy.searchLabel}</label>
      <svg class="curriculum-search__icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.7" cy="8.7" r="5.8" /><path d="m13 13 4 4" /></svg>
      <input
        id="curriculum-search"
        type="search"
        placeholder={copy.searchPlaceholder}
        autocomplete="off"
        spellcheck="false"
        aria-controls="curriculum-results"
        data-curriculum-search
      />
      <button class="curriculum-search__clear" type="button" aria-label={copy.clearSearch} data-clear-search hidden>×</button>
    </div>

    <div class="phase-filter" role="group" aria-label={copy.filterLabel}>
      <button
        class="phase-filter__button is-active"
        type="button"
        aria-pressed="true"
        aria-label={locale === 'en'
          ? `${copy.showAll}: ${coreModules.length} ${copy.coreModules} and ${supplementModules.length} ${copy.optionalExtras}`
          : `${copy.showAll}: ${coreModules.length} ${copy.coreModules} y ${supplementModules.length} ${copy.optionalExtras}`}
        data-phase-filter="all"
      >
        {copy.all} <span>{coreModules.length}+{supplementModules.length}</span>
      </button>
      {phases.map((phase) => (
        <button
          class="phase-filter__button"
          type="button"
          aria-pressed="false"
          aria-label={`${copy.filterPhase} ${String(phase.id).padStart(2, '0')}: ${phaseDescription(phase.id)}`}
          data-phase-filter={phase.id}
        >
          {copy.phase} {String(phase.id).padStart(2, '0')} <span>{phaseFilterCount(phase.id)}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="curriculum-results-bar">
    <p class="curriculum-results-count" data-results-count aria-live="polite" aria-atomic="true">
      {pluralize(totalLessons, copy.lesson, copy.lessons)} · {coreModules.length} {coreModules.length === 1 ? copy.coreModule : copy.coreModules} + {pluralize(supplementModules.length, copy.optionalExtra, copy.optionalExtras)}
    </p>
    <p class="curriculum-results-hint">{copy.resultsHint}</p>
  </div>

  <div class="curriculum-results" id="curriculum-results">
    <div class="curriculum-empty" data-empty-state hidden role="status">
      <span class="curriculum-empty__symbol" aria-hidden="true">⌕</span>
      <div>
        <strong>{copy.noResults}</strong>
        <p>{copy.noResultsHint}</p>
      </div>
      <button type="button" class="text-button" data-filter-reset>{copy.clearFilters} <span aria-hidden="true">↗</span></button>
    </div>

    {phaseGroups.map(({ phase, coreModules: phaseCoreModules, supplementModules: phaseSupplements, lessonCount }) => (
      <section class="phase-group" data-phase-section data-phase={phase.id} aria-labelledby={`phase-${phase.id}-title`}>
        <header class="phase-group__header">
          <div class="phase-group__number" aria-hidden="true">{String(phase.id).padStart(2, '0')}</div>
          <div class="phase-group__title-wrap">
            <span class="phase-group__kicker">{copy.phaseLabel} {String(phase.id).padStart(2, '0')}</span>
            <h3 id={`phase-${phase.id}-title`}>{phase.title}</h3>
          </div>
          <p class="phase-group__count">
            <span>{pluralize(phaseCoreModules.length, copy.coreModule, copy.coreModules)}{phaseSupplements.length > 0 ? ` + ${pluralize(phaseSupplements.length, copy.optionalExtra, copy.optionalExtras)}` : ''}</span>
            <br />{pluralize(lessonCount, copy.lesson, copy.lessons)}
          </p>
          <span class="phase-group__rule" aria-hidden="true"></span>
        </header>

        <div class="module-list">
          {phaseCoreModules.map((module) => (
            <CurriculumModuleCard
              module={module}
              locale={locale}
              coreModuleCount={coreModules.length}
              supplementCount={supplementModules.length}
              initialOpen={module.id === firstModule?.id}
            />
          ))}
        </div>

        {phaseSupplements.length > 0 && (
          <div class="supplement-group" role="group" aria-labelledby={`supplements-${phase.id}-title`}>
            <div class="supplement-group__heading">
              <div>
                <span class="eyebrow eyebrow--terra">{copy.supplementHeading}</span>
                <h4 id={`supplements-${phase.id}-title`}>{copy.deeperHeading}</h4>
                <p>{copy.deeperText}</p>
              </div>
              <span class="supplement-group__count">
                {pluralize(phaseSupplements.length, copy.extra, copy.extras)}<br />
                {pluralize(phaseSupplements.reduce((count, module) => count + module.lessons.length, 0), copy.lesson, copy.lessons)}
              </span>
            </div>
            <div class="module-list module-list--supplements">
              {phaseSupplements.map((module) => (
                <CurriculumModuleCard
                  module={module}
                  locale={locale}
                  coreModuleCount={coreModules.length}
                  supplementCount={supplementModules.length}
                  supplementIndex={supplementModules.findIndex((item) => item.id === module.id) + 1}
                />
              ))}
            </div>
          </div>
        )}
      </section>
    ))}
  </div>

  <p class="curriculum-caveat">{copy.caveat}</p>
</section>

<script>
  const explorer = document.querySelector<HTMLElement>('[data-curriculum-explorer]');

  if (explorer) {
    const locale = explorer.dataset.locale === 'en' ? 'en' : 'es';
    const text = locale === 'en'
      ? {
          module: 'module', modules: 'modules',
          extra: 'optional extra', extras: 'optional extras',
          lesson: 'lesson', lessons: 'lessons',
          complete: 'You have marked every lesson and optional extra in this path as complete in this browser.',
          partial: 'Your progress is saved only in this browser; optional extras are up to you.',
          ariaCompleted: 'lessons completed',
          review: 'Review from the beginning',
          continue: 'Continue',
        }
      : {
          module: 'módulo', modules: 'módulos',
          extra: 'complemento opcional', extras: 'complementos opcionales',
          lesson: 'lección', lessons: 'lecciones',
          complete: 'Has marcado todas las lecciones y complementos de este recorrido en este navegador.',
          partial: 'Tu avance solo se guarda en este navegador; los complementos son opcionales.',
          ariaCompleted: 'lecciones completadas',
          review: 'Repasar desde el inicio',
          continue: 'Continuar',
        };
    const controls = explorer.querySelector<HTMLElement>('[data-curriculum-controls]');
    const searchInput = explorer.querySelector<HTMLInputElement>('[data-curriculum-search]');
    const clearSearchButton = explorer.querySelector<HTMLButtonElement>('[data-clear-search]');
    const filterButtons = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-phase-filter]'));
    const cards = Array.from(explorer.querySelectorAll<HTMLDetailsElement>('[data-module-card]'));
    const phaseSections = Array.from(explorer.querySelectorAll<HTMLElement>('[data-phase-section]'));
    const resultsCount = explorer.querySelector<HTMLElement>('[data-results-count]');
    const emptyState = explorer.querySelector<HTMLElement>('[data-empty-state]');
    const resetButton = explorer.querySelector<HTMLButtonElement>('[data-filter-reset]');
    let activePhase = 'all';

    const normalize = (value: string) =>
      value.toLocaleLowerCase(locale === 'es' ? 'es' : 'en').normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
    const updateResults = () => {
      if (!searchInput || !resultsCount || !emptyState) return;

      const query = normalize(searchInput.value);
      let visibleCoreModules = 0;
      let visibleSupplements = 0;
      let visibleLessons = 0;

      cards.forEach((card) => {
        const phaseMatches = activePhase === 'all' || card.dataset.phase === activePhase;
        const moduleMatches = query.length === 0 || normalize(card.dataset.search ?? '').includes(query);
        const lessonItems = Array.from(card.querySelectorAll<HTMLElement>('[data-lesson-item]'));
        let matchingLessons = 0;

        lessonItems.forEach((item) => {
          const lessonMatches = query.length === 0 || moduleMatches || normalize(item.dataset.search ?? '').includes(query);
          item.hidden = !lessonMatches;
          if (lessonMatches) matchingLessons += 1;
        });

        const cardMatches = phaseMatches && (moduleMatches || matchingLessons > 0);
        card.hidden = !cardMatches;
        if (query.length > 0 && cardMatches) card.open = true;
        if (cardMatches) {
          if (card.dataset.supplement === 'true') visibleSupplements += 1;
          else visibleCoreModules += 1;
          visibleLessons += matchingLessons;
        }
      });

      phaseSections.forEach((section) => {
        const sectionCards = Array.from(section.querySelectorAll<HTMLDetailsElement>('[data-module-card]'));
        section.hidden = !sectionCards.some((card) => !card.hidden);
      });

      const moduleLabel = visibleCoreModules === 1 ? text.module : text.modules;
      const supplementLabel = visibleSupplements === 1 ? text.extra : text.extras;
      const lessonLabel = visibleLessons === 1 ? text.lesson : text.lessons;
      resultsCount.textContent = `${visibleLessons} ${lessonLabel} · ${visibleCoreModules} ${moduleLabel} + ${visibleSupplements} ${supplementLabel}`;
      emptyState.hidden = visibleCoreModules + visibleSupplements > 0;
      if (clearSearchButton) clearSearchButton.hidden = searchInput.value.length === 0;
      filterButtons.forEach((button) => {
        const isActive = button.dataset.phaseFilter === activePhase;
        button.setAttribute('aria-pressed', String(isActive));
        button.classList.toggle('is-active', isActive);
      });
    };

    if (searchInput && controls) {
      searchInput.addEventListener('input', updateResults);
      clearSearchButton?.addEventListener('click', () => {
        searchInput.value = '';
        updateResults();
        searchInput.focus();
      });
      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          activePhase = button.dataset.phaseFilter ?? 'all';
          updateResults();
        });
      });
      resetButton?.addEventListener('click', () => {
        activePhase = 'all';
        searchInput.value = '';
        updateResults();
        searchInput.focus();
      });
      controls.hidden = false;
      updateResults();
    }

    const progressPanel = explorer.querySelector<HTMLElement>('[data-progress-panel]');
    if (progressPanel) {
      const lessons = Array.from(explorer.querySelectorAll<HTMLAnchorElement>('[data-lesson-link]')).map((link) => ({
        id: link.dataset.lessonId ?? '',
        href: link.getAttribute('href') ?? '#temario',
        title: link.textContent?.trim() ?? text.lesson,
      })).filter((lesson) => lesson.id.length > 0);
      const knownIds = new Set(lessons.map((lesson) => lesson.id));
      let completedIds = new Set<string>();

      try {
        const saved = window.localStorage.getItem('leadtech:completed:v1');
        if (saved !== null) {
          const parsed: unknown = JSON.parse(saved);
          if (Array.isArray(parsed)) {
            completedIds = new Set(
              parsed.filter((value): value is string => typeof value === 'string' && knownIds.has(value)),
            );
          }
        }
      } catch {
        completedIds = new Set();
      }

      if (completedIds.size > 0 && lessons.length > 0) {
        const completedCount = Math.min(completedIds.size, lessons.length);
        const nextLesson = lessons.find((lesson) => !completedIds.has(lesson.id)) ?? lessons[0];
        const count = explorer.querySelector<HTMLElement>('[data-progress-count]');
        const message = explorer.querySelector<HTMLElement>('[data-progress-message]');
        const meter = explorer.querySelector<HTMLElement>('[data-progress-meter]');
        const fill = explorer.querySelector<HTMLElement>('[data-progress-fill]');
        const continueLink = explorer.querySelector<HTMLAnchorElement>('[data-continue-link]');
        const continueLabel = explorer.querySelector<HTMLElement>('[data-progress-link-label]');
        const isComplete = completedCount === lessons.length;
        const percentage = Math.round((completedCount / lessons.length) * 100);

        if (count) count.textContent = String(completedCount);
        if (message) message.textContent = isComplete ? text.complete : text.partial;
        if (meter) {
          meter.setAttribute('aria-valuenow', String(completedCount));
          meter.setAttribute('aria-valuetext', `${completedCount} ${locale === 'en' ? 'of' : 'de'} ${lessons.length} ${text.ariaCompleted}`);
        }
        if (fill) fill.style.width = `${percentage}%`;
        if (continueLink && nextLesson) continueLink.href = nextLesson.href;
        if (continueLabel && nextLesson) {
          continueLabel.textContent = isComplete ? text.review : `${text.continue}: ${nextLesson.title}`;
        }
        progressPanel.hidden = false;
      }
    }
  }
</script>
