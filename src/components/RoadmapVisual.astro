<figure
  class="roadmap-visual"
  role="img"
  aria-label="Recorrido único para desarrollar software con inteligencia artificial en cuatro fases: construir la base, explorar herramientas, trabajar con criterio y llevarlo a un proyecto."
>
  <div class="roadmap-visual__frame">
    <div class="roadmap-visual__topline" aria-hidden="true">
      <span><i></i> DESARROLLO DE SOFTWARE CON IA</span>
      <span>01 — 04</span>
    </div>

    <svg class="roadmap-visual__svg" viewBox="0 0 680 500" aria-hidden="true" focusable="false">
      <defs>
        <pattern id="roadmap-grid" width="28" height="28" patternUnits="userSpaceOnUse">
          <path d="M28 0H0V28" fill="none" stroke="#24384A" stroke-opacity=".075" stroke-width="1" />
        </pattern>
        <filter id="roadmap-shadow" x="-50%" y="-50%" width="200%" height="200%">
          <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#23384A" flood-opacity=".13" />
        </filter>
      </defs>
      <rect x="1" y="1" width="678" height="498" rx="26" fill="url(#roadmap-grid)" />
      <path
        class="roadmap-visual__route-shadow"
        d="M91 376C143 334 172 280 231 292C289 304 303 372 363 353C420 335 414 238 472 220C533 202 549 268 604 218C632 193 630 151 615 115"
      />
      <path
        class="roadmap-visual__route"
        d="M91 376C143 334 172 280 231 292C289 304 303 372 363 353C420 335 414 238 472 220C533 202 549 268 604 218C632 193 630 151 615 115"
      />
      <path class="roadmap-visual__route-dots" d="M91 376C143 334 172 280 231 292C289 304 303 372 363 353C420 335 414 238 472 220C533 202 549 268 604 218C632 193 630 151 615 115" />

      <g class="roadmap-visual__node roadmap-visual__node--one" filter="url(#roadmap-shadow)">
        <circle cx="91" cy="376" r="22" fill="#F5F1E8" stroke="#D76A48" stroke-width="2" />
        <circle cx="91" cy="376" r="6" fill="#D76A48" />
        <text x="61" y="425" class="roadmap-visual__number">01</text>
        <text x="61" y="446" class="roadmap-visual__label">BASE</text>
      </g>
      <g class="roadmap-visual__node roadmap-visual__node--two" filter="url(#roadmap-shadow)">
        <circle cx="231" cy="292" r="22" fill="#F5F1E8" stroke="#24384A" stroke-width="2" />
        <circle cx="231" cy="292" r="6" fill="#24384A" />
        <text x="204" y="248" class="roadmap-visual__number">02</text>
        <text x="204" y="228" class="roadmap-visual__label">EXPLORA</text>
      </g>
      <g class="roadmap-visual__node roadmap-visual__node--three" filter="url(#roadmap-shadow)">
        <circle cx="472" cy="220" r="22" fill="#F5F1E8" stroke="#24384A" stroke-width="2" />
        <circle cx="472" cy="220" r="6" fill="#24384A" />
        <text x="439" y="174" class="roadmap-visual__number">03</text>
        <text x="439" y="153" class="roadmap-visual__label">CRITERIO</text>
      </g>
      <g class="roadmap-visual__node roadmap-visual__node--four" filter="url(#roadmap-shadow)">
        <circle cx="615" cy="115" r="25" fill="#D76A48" stroke="#F5F1E8" stroke-width="6" />
        <path d="m605 115 7 7 14-16" fill="none" stroke="#FFF9F2" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
        <text x="565" y="68" class="roadmap-visual__number">04</text>
        <text x="565" y="47" class="roadmap-visual__label">CONSTRUYE</text>
      </g>

      <g class="roadmap-visual__scribble" aria-hidden="true">
        <path d="M106 114c22-16 46-22 67-15" fill="none" stroke="#D76A48" stroke-width="2" stroke-linecap="round" />
        <path d="m166 91 9 8-10 4" fill="none" stroke="#D76A48" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <text x="93" y="94">aprende haciendo</text>
      </g>
    </svg>

    <div class="roadmap-visual__note roadmap-visual__note--top" aria-hidden="true">
      <span class="roadmap-visual__note-mark">+</span>
      <span><strong>Una idea</strong><small>se vuelve práctica</small></span>
    </div>
    <div class="roadmap-visual__note roadmap-visual__note--bottom" aria-hidden="true">
      <span class="roadmap-visual__note-index">12</span>
      <span><strong>módulos</strong><small>para avanzar a tu ritmo</small></span>
    </div>
    <div class="roadmap-visual__stamp" aria-hidden="true">
      <span>MENOS<br />ATAJOS</span>
      <span class="roadmap-visual__stamp-star">✳</span>
      <span>MÁS<br />CRITERIO</span>
    </div>
  </div>
  <figcaption class="roadmap-visual__caption">
    <span>Un paso a la vez.</span>
    <span>De la curiosidad a la práctica <span aria-hidden="true">↗</span></span>
  </figcaption>
</figure>
